{
  "name": "poi-harvester",
  "version": "0.1.0",
  "description": "Harvests licensed POIs, deduplicates them, and publishes an auditable spatial layer.",
  "entrypoint": "poi-harvester run",
  "inputs": ["area_of_interest_bbox_or_polygon_or_named_place_catalog", "category_or_categories_or_intent", "declared_use", "source_selection", "contact_for_live_sources", "optional_geocode_catalog", "database", "workspace", "optional_schema"],
  "outputs": ["poi_layer", "metadata", "change_set", "exclusions", "review_queue"],
  "states": ["completed", "needs_input", "failed"]
}
