{
  "name": "poi-harvester",
  "version": "0.3.0",
  "description": "Harvests policy-gated POIs, enriches bilingual names, deduplicates them, and publishes an auditable spatial layer.",
  "entrypoint": "poi-harvester run",
  "inputs": [
    "bbox_or_polygon_or_named_place",
    "category_or_categories_or_English_Arabic_intent",
    "declared_use",
    "source_selection",
    "contact_for_live_sources",
    "optional_place_catalog_or_provider",
    "optional_geocode_catalog_or_provider",
    "database_for_publication",
    "workspace_for_publication",
    "optional_schema",
    "optional_freshness_policy"
  ],
  "outputs": [
    "poi_layer",
    "metadata",
    "change_set",
    "exclusions",
    "review_queue"
  ],
  "states": [
    "completed",
    "needs_input",
    "failed"
  ],
  "contract_status": "NOT_AVAILABLE",
  "evaluation_outputs": [
    "report_json",
    "license_report_json",
    "taxonomy_report_json",
    "readiness_markdown",
    "arabic_review_score_json",
    "benchmark_report_json",
    "tests_log"
  ],
  "enrichment_version": "rules-v3",
  "supported_conflation_versions": [
    1,
    2,
    3
  ],
  "audit_outputs": [
    "source_capture_json",
    "provenance_json",
    "timings_json"
  ],
  "human_review_evidence": {
    "dataset": "fixtures/arabic_name_review.json",
    "ratings": "fixtures/arabic_name_review_human_ratings.json",
    "manifest": "fixtures/arabic_name_review_manifest.json",
    "status": "REVIEWED",
    "human_reviewed": 100,
    "human_accepted": 100,
    "human_rejected": 0,
    "unreviewed": 0,
    "official_status": "NOT_CERTIFIED"
  }
}
